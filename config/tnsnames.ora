# tnsnames.ora per Data Guard
# Definisce alias per CDB e PDB con supporto failover automatico

# CDB

# Connessione diretta al Primario
ORCL_PRI =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node1)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = ORCL)
    )
  )

# Connessione diretta allo Standby
ORCL_STBY_NODE1 =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = orcl_stby_node1)
    )
  )

# Connessione con failover automatico (prova prima node1, poi node5)
ORCL =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node1)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = ORCL)
    )
  )

