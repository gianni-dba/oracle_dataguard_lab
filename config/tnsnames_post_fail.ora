# tnsnames.ora per Data Guard
# Definisce alias per CDB e PDB con supporto failover automatico
# CDB
# Connessione diretta al Primario (mantenuto per retrocompatibilità, abitudine dei client)
ORCL_PRI =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = ORCL)
    )
  )

# Connessione diretta al Primario
ORCL_STBY_NODE1 =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = orcl_stby_node1)
    )
  )

#connessione standby
ORCL_STBY_NEW =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node6)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = orcl_stby_new)
    )
  )

#connessione failover
ORCL =
  (DESCRIPTION =
    (ADDRESS_LIST =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node6)(PORT = 1521))
    )
    (CONNECT_DATA =
      (SERVICE_NAME = ORCL)
    )
  )


