  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = oracle-node5)(PORT = 1521))
    )
  )

# per Data Guard - RMAN in NOMOUNT
SID_LIST_LISTENER =
